DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth (admin panel)
AUTH_SECRET="change-me-to-a-random-string"

# Seed admin credentials (used by prisma/seed.ts and GET /api/seed)
ADMIN_EMAIL="admin@kunfoods.com"
ADMIN_PASSWORD="change-me"

# --- Optional: notifications (app runs fine without these, just logs instead) ---

# Email (https://resend.com)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Kun Foods <onboarding@resend.dev>"
# ADMIN_NOTIFICATION_EMAIL="you@example.com"

# SMS (https://www.twilio.com)
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_PHONE_NUMBER="+15551234567"

# WhatsApp order button (international format, no + or spaces)
# NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"

# Shown as the "From" address on printable shipping labels
# STORE_ADDRESS="Kun Foods, Main Boulevard, Lahore, Pakistan"
# STORE_PHONE="+92 300 1234567"
