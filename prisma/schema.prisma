generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  description    String
  price          Int // price in smallest currency unit (paisa)
  compareAtPrice Int?
  images         String // JSON-encoded array of image URLs/emojis
  badge          String? // e.g. "Bestseller", "New", "Sale"
  weightLabel    String? // e.g. "500g", "1kg"
  stock          Int          @default(100)
  featured       Boolean      @default(false)
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  bundleItems    BundleItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Bundle {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String
  image       String // emoji
  price       Int // bundle price in paisa (should be less than sum of components)
  active      Boolean      @default(true)
  items       BundleItem[]
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String // "percentage" | "fixed"
  value       Int // 1-100 for percentage, paisa amount for fixed
  minSubtotal Int       @default(0)
  usageLimit  Int?
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  orders      Order[]
  createdAt   DateTime  @default(now())
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  address   String?
  city      String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  customerName  String
  email         String
  phone         String
  address       String
  city          String
  postalCode    String?
  notes         String?
  paymentMethod String // "cod" | "card" | "cash"
  status        String      @default("pending") // pending | processing | shipped | delivered | cancelled
  source        String      @default("web") // "web" | "pos"
  subtotal      Int
  discount      Int         @default(0)
  couponId      String?
  coupon        Coupon?     @relation(fields: [couponId], references: [id])
  shipping      Int
  total         Int
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  bundleId  String?
  bundle    Bundle? @relation(fields: [bundleId], references: [id])
  name      String
  price     Int
  quantity  Int
}

model ShippingZone {
  id        String   @id @default(cuid())
  city      String   @unique
  rate      Int // paisa
  freeAbove Int? // paisa; order subtotal (after discount) at or above this ships free. null = never auto-free
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}
