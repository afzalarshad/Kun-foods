generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  image       String?
  products    Product[]
  promotions  Promotion[]
  createdAt   DateTime    @default(now())
}

model Product {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  description    String
  price          Int // price in smallest currency unit (paisa)
  compareAtPrice Int?
  costPrice      Int? // paisa; for margin/inventory valuation reporting
  sku            String?             @unique
  barcode        String?             @unique
  supplier       String?
  reorderLevel   Int? // dashboard flags stock at/below this as low
  images         String // JSON-encoded array of image URLs/emojis
  badge          String? // e.g. "Bestseller", "New", "Sale"
  weightLabel    String? // e.g. "500g", "1kg"
  stock          Int                 @default(100)
  featured       Boolean             @default(false)
  active         Boolean             @default(true) // hidden from storefront when false, without deleting history
  categoryId     String
  category       Category            @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  bundleItems    BundleItem[]
  movements      InventoryMovement[]
  promotions     Promotion[]
  warehouseStock WarehouseStock[]
  stockTransfers StockTransfer[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Warehouse {
  id            String              @id @default(cuid())
  name          String
  code          String              @unique
  city          String
  address       String?
  isDefault     Boolean             @default(false)
  active        Boolean             @default(true)
  stockLevels   WarehouseStock[]
  orders        Order[]
  movements     InventoryMovement[]
  transfersFrom StockTransfer[]     @relation("TransferFrom")
  transfersTo   StockTransfer[]     @relation("TransferTo")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model WarehouseStock {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
}

model StockTransfer {
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  quantity        Int
  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  reason          String?
  actorEmail      String?
  createdAt       DateTime  @default(now())
}

model Bundle {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String
  image       String // emoji
  price       Int // bundle price in paisa (should be less than sum of components)
  active      Boolean      @default(true)
  items       BundleItem[]
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String // "percentage" | "fixed"
  value       Int // 1-100 for percentage, paisa amount for fixed
  minSubtotal Int       @default(0)
  usageLimit  Int?
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  orders      Order[]
  createdAt   DateTime  @default(now())
}

model Promotion {
  id                 String    @id @default(cuid())
  name               String
  type               String // "percentage_off" | "fixed_off" | "bogo"
  scope              String // "all" | "category" | "product" ("bogo" always implies "product")
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id])
  productId          String?
  product            Product?  @relation(fields: [productId], references: [id])
  segment            String? // optional SegmentId (src/lib/segments.ts); null = every customer
  value              Int? // percentage_off: 1-100; fixed_off: paisa amount
  buyQuantity        Int? // bogo: buy this many
  getQuantity        Int? // bogo: get this many at getDiscountPercent off
  getDiscountPercent Int? // bogo: 100 = free, 50 = half off, etc.
  startsAt           DateTime?
  endsAt             DateTime?
  active             Boolean   @default(true)
  priority           Int       @default(0) // lower runs first; mainly for reporting order, discounts always stack
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Customer {
  id        String            @id @default(cuid())
  name      String
  email     String            @unique
  phone     String
  address   String?
  city      String?
  source    String? // how they found us / acquisition channel, free text
  orders    Order[]
  tags      CustomerTag[]
  notes     CustomerNote[]
  tickets   SupportTicket[]
  addresses CustomerAddress[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String // e.g. "Home", "Office"
  address    String
  city       String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model CustomerTag {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        String
  createdAt  DateTime @default(now())

  @@unique([customerId, tag])
}

model CustomerNote {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  note        String
  authorEmail String?
  createdAt   DateTime @default(now())
}

model Order {
  id                 String            @id @default(cuid())
  orderNumber        String            @unique
  customerId         String?
  customer           Customer?         @relation(fields: [customerId], references: [id])
  customerName       String
  email              String
  phone              String
  address            String
  city               String
  postalCode         String?
  notes              String?
  paymentMethod      String // "cod" | "card" | "cash"
  status             String            @default("pending") // pending | processing | packed | shipped | delivered | cancelled
  cancellationReason String?
  priority           String            @default("normal") // low | normal | high | urgent
  assignedTo         String? // staff email responsible for fulfilling this order
  source             String            @default("web") // "web" | "pos"
  warehouseId        String? // which physical location is fulfilling this order
  warehouse          Warehouse?        @relation(fields: [warehouseId], references: [id])
  subtotal           Int
  discount           Int               @default(0)
  couponId           String?
  coupon             Coupon?           @relation(fields: [couponId], references: [id])
  promoDiscount      Int               @default(0)
  promotionsJson     String? // JSON-encoded array of {id, name, discount} auto-applied promotions
  shipping           Int
  total              Int
  items              OrderItem[]
  statusEvents       OrderStatusEvent[]
  returns            Return[]
  payments           Payment[]
  shipment           Shipment?
  tickets            SupportTicket[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  bundleId       String?
  bundle         Bundle?  @relation(fields: [bundleId], references: [id])
  name           String
  price          Int
  quantity       Int
  pickedQuantity Int      @default(0)
}

model OrderStatusEvent {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String
  note        String?
  actorEmail  String?
  createdAt   DateTime @default(now())
}

model Return {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason     String
  status     String   @default("requested") // requested | approved | rejected | received | refunded
  notes      String?
  actorEmail String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model InventoryMovement {
  id          String     @id @default(cuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  type        String // "sale" | "return" | "adjustment" | "restock" | "transfer_out" | "transfer_in"
  quantity    Int // signed: negative = stock decreased, positive = stock increased
  reason      String?
  orderId     String?
  actorEmail  String?
  createdAt   DateTime   @default(now())
}

model Payment {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Int
  method         String // "cod" | "cash" | "card" | "bank_transfer" | "other"
  status         String   @default("pending") // pending | paid | refunded | partially_refunded
  transactionRef String?
  notes          String?
  actorEmail     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Shipment {
  id                String    @id @default(cuid())
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier           String // "leopards" | "tcs" | "postex" | "manual"
  trackingNumber    String?
  status            String    @default("pending") // pending | booked | picked_up | in_transit | delivered | returned
  codAmount         Int?
  weightGrams       Int?
  labelGeneratedAt  DateTime?
  actorEmail        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model SupportTicket {
  id           String          @id @default(cuid())
  ticketNumber String          @unique
  customerId   String?
  customer     Customer?       @relation(fields: [customerId], references: [id])
  orderId      String?
  order        Order?          @relation(fields: [orderId], references: [id])
  subject      String
  category     String // order | payment | delivery | return | refund | product | complaint | general
  priority     String          @default("normal") // low | normal | high | urgent
  status       String          @default("open") // open | pending | in_progress | waiting_on_customer | resolved | closed
  assignedTo   String?
  firstResponseAt DateTime? // set when the first follow-up staff message lands (SLA response tracking)
  resolvedAt      DateTime? // set when status moves to resolved/closed; cleared if reopened
  messages     TicketMessage[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model TicketMessage {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorEmail String?
  authorType  String // "staff" | "customer" | "system"
  message     String
  internal    Boolean       @default(false)
  createdAt   DateTime      @default(now())
}

model ShippingZone {
  id        String   @id @default(cuid())
  scope     String   @default("city") // "city" | "province"
  city      String? // set when scope = "city"; matched against src/lib/pakistan-locations.ts
  province  String? // set when scope = "province"; one of PAKISTAN_PROVINCES
  rate      Int // paisa
  freeAbove Int? // paisa; order subtotal (after discount) at or above this ships free. null = never auto-free
  excluded  Boolean  @default(false) // true = no delivery to this city/province, regardless of rate
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin") // see src/lib/permissions.ts ROLE_PERMISSIONS for the full role -> permission map
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String // e.g. "product.create", "order.status_update"
  entityType String
  entityId   String?
  before     String? // JSON snapshot
  after      String? // JSON snapshot
  createdAt  DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "order_created_email"
  channel   String // "email" | "sms"
  subject   String? // email only
  body      String // supports {{variable}} placeholders
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model AdminNotification {
  id        String   @id @default(cuid())
  type      String // "low_stock" | "new_order" | "new_ticket" | "return_requested"
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Webhook {
  id              String    @id @default(cuid())
  name            String
  url             String
  secret          String // HMAC-signs the payload (X-Kun-Signature header) so receivers can verify authenticity
  events          String // JSON-encoded array of subscribed event names, e.g. ["order.created"]
  active          Boolean   @default(true)
  lastStatus      String? // e.g. "200" or "error: timeout"
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model HeldSale {
  id         String   @id @default(cuid())
  label      String? // optional note, e.g. "Ahmed - blue shirt"
  cart       String // JSON-encoded line items
  customer   String // JSON-encoded customer/delivery fields
  actorEmail String?
  createdAt  DateTime @default(now())
}
